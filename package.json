{
  "name": "composeanything",
  "version": "0.1.0",
  "description": "Un copiloto de IA pegado a MuseScore: panel de chat + servidor MCP que compone, edita y transcribe en vivo.",
  "main": "src/app/main.js",
  "bin": {
    "composeanything-mcp": "src/mcp/server.js"
  },
  "scripts": {
    "start": "electron .",
    "mcp": "node src/mcp/server.js",
    "test": "node --test",
    "selftest": "node scripts/selftest-live.js",
    "install-plugin": "node scripts/install-plugin.js",
    "mock": "node src/dev/mock-musescore.js",
    "smoke": "electron . --smoke-test",
    "icon": "node scripts/make-icon.js",
    "pack": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.pentavm.composeanything",
    "productName": "ComposeAnything",
    "copyright": "Copyright (c) 2026 PentaVM",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "plugin/**/*",
      "scripts/dock-windows.ps1",
      "build/icon.png",
      "LICENSE",
      "NOTICE.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ComposeAnything-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ComposeAnything",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PentaVM/ComposeAnything.git"
  },
  "homepage": "https://github.com/PentaVM/ComposeAnything#readme",
  "author": "PentaVM",
  "keywords": [
    "musescore",
    "mcp",
    "ai",
    "music",
    "composition",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  }
}
